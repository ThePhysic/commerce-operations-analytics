    "snapshot_date": {"type": "date", "description": "UTC date of inventory observation"},
    "expected_quantity": {"type": "integer", "minimum": 0, "description": "Expected units from inventory ledger"},
    "actual_quantity": {"type": "integer", "minimum": 0, "description": "Observed units; zero defines stockout"},
